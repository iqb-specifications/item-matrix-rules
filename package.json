{
  "name": "@iqbspecs/testcenter-workspace-config",
  "author": "IQB - Institut zur Qualitätsentwicklung im Bildungswesen",
  "license": "CC0-1.0",
  "description": "Rules for translating variable response status into item missing value.",
  "scripts": {
    "validate-schema": "test-schema test missing-map.schema.json",
    "async_generate": "asyncapi generate fromTemplate asyncapi.yaml @asyncapi/html-template --param config=asyncapi.config.json -o ./public --force-write --use-new-generator",
    "generate_docs": "npm run async_generate && cat add.css >> ./public/css/global.min.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqb-specifications/missing-map.git"
  },
  "bugs": {
    "url": "https://github.com/iqb-specifications/missing-map/issues"
  },
  "homepage": "https://github.com/iqb-specifications/missing-map#readme",
  "devDependencies": {
    "@asyncapi/cli": "^4.1.1",
    "@asyncapi/html-template": "^3.1.0",
    "@iqbspecs/validate-json": "^0.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@asyncapi/generator-react-sdk": {
      "react": "17.0.2"
    }
  }
}
